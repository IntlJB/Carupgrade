{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.carupgrade.dk"
        }
      ],
      "destination": "https://carupgrade.dk/:path*",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/local-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/product-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/bil-mekaniker-hos-dig",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/bil-mekaniker-hos-dig/",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privatlivspolitik/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privatlivspolitik/",
      "permanent": true
    },
    {
      "source": "/refund_returns",
      "destination": "/handels-og-garantibestemmelser/",
      "permanent": true
    },
    {
      "source": "/refund_returns/",
      "destination": "/handels-og-garantibestemmelser/",
      "permanent": true
    },
    {
      "source": "/8,8",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/tilbudsberegner",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/tilbudsberegner/",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/om-carupgrade",
      "destination": "/#omOs",
      "permanent": true
    },
    {
      "source": "/om-carupgrade/",
      "destination": "/#omOs",
      "permanent": true
    },
    {
      "source": "/product/:slug((?:.*carplay.*|.*android-auto.*|.*androidauto.*|.*oemupgrade.*|.*infotainment.*|.*toyota-chr.*|.*toyota-c-hr.*|.*volkswagen.*))",
      "destination": "/biludstyr-og-infotainment/",
      "permanent": true
    },
    {
      "source": "/product-category/:slug((?:.*carplay.*|.*android-auto.*|.*androidauto.*|.*oemupgrade.*|.*infotainment.*|.*toyota-chr.*|.*toyota-c-hr.*|.*volkswagen.*))",
      "destination": "/biludstyr-og-infotainment/",
      "permanent": true
    },
    {
      "source": "/product/(.*)",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/product-category/(.*)",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/#kontakt",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/om-os",
      "destination": "/#omOs",
      "permanent": true
    },
    {
      "source": "/anmeldelser",
      "destination": "/#anmeldelser",
      "permanent": true
    },
    {
      "source": "/reparationer",
      "destination": "/#reparationer",
      "permanent": true
    },
    {
      "source": "/handelsbetingelser",
      "destination": "/handels-og-garantibestemmelser/",
      "permanent": true
    },
    {
      "source": "/garanti",
      "destination": "/handels-og-garantibestemmelser/",
      "permanent": true
    },
    {
      "source": "/privatpolitik",
      "destination": "/privatlivspolitik/",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/cookiepolitik/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/FAQ/",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/FAQ/",
      "permanent": true
    },
    {
      "source": "/FAQ",
      "destination": "/FAQ/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-content/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-admin/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-(.*).php",
      "destination": "/api/gone"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</assets/repair-work-2.webp>; rel=preload; as=image; type=image/webp"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
